{
  "template_name": "ビジネス文書",
  "builtin": true,
  "body": {
    "font-family": "\"Noto Sans JP\", \"Yu Gothic\", \"Meiryo\", sans-serif",
    "font-size": "14px",
    "line-height": 1.5,
    "text-align": "left"
  },
  "p": {
    "text-indent": "0",
    "margin-bottom": "0.5em"
  },
  "h1": {
    "font-size": "1.4em",
    "font-weight": "bold",
    "margin-top": "2em",
    "margin-bottom": "1em",
    "page-break-before": true
  },
  "h2": {
    "font-size": "1.2em",
    "font-weight": "bold",
    "margin-top": "1.5em",
    "margin-bottom": "0.5em",
    "border-bottom": "1px solid #999"
  },
  "h3": {
    "font-size": "1.0em",
    "font-weight": "bold",
    "margin-top": "1em",
    "margin-bottom": "0.3em"
  },
  "custom_css": ""
}
